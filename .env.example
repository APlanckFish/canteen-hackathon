# =====================
# Public (NEXT_PUBLIC_*)
# =====================
NEXT_PUBLIC_ARC_CHAIN_ID=
# 推荐使用 Canteen 黑客松专属 RPC（运行 `arc-canteen rpc-url` 获取你自己的 token URL）
# 也可以用通用公开 RPC: https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc-node.thecanteenapp.com/v1/<your-arc-canteen-rpc-key>
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app
NEXT_PUBLIC_POLYGON_CHAIN_ID=137
# 免费公共 RPC（无需 key），生产建议换 Alchemy / Quicknode 自己的 endpoint
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
NEXT_PUBLIC_PAYMENT_VAULT_ADDRESS=
NEXT_PUBLIC_USDC_ARC_ADDRESS=
NEXT_PUBLIC_INSIGHT_PRICE_USDC=0.01
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# =====================
# Server only
# =====================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io

GAMMA_BASE_URL=https://gamma-api.polymarket.com

# Vercel KV (Upstash Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 预留给未来真实 settler，Demo 不使用
OPS_WALLET_PRIVATE_KEY=

# Contracts deploy
ARC_RPC_URL=https://rpc.testnet.arc-node.thecanteenapp.com/v1/<your-arc-canteen-rpc-key>
DEPLOYER_PRIVATE_KEY=
USDC_ARC_ADDRESS=
