# Foundry deploy 用
# 通过 `source .env && forge script ...` 注入；或直接在 forge 命令前 `--rpc-url $ARC_RPC_URL`

# Canteen 黑客松专属 RPC（含私 token）
# 如需轮换 token：arc-canteen rotate-rpc-key
ARC_RPC_URL=
ARC_CHAIN_ID=

# 部署用的私钥（带 0x 前缀的 64 位 hex），DEMO 用专属小号，不要放主账号！
DEPLOYER_PRIVATE_KEY=

# Arc 测试网上的 USDC ERC20 合约地址
USDC_ARC_ADDRESS=0x3600000000000000000000000000000000000000

# 单次解锁最低支付的 USDC 数量（人类可读，Deploy.s.sol 会自动按 USDC 6 位小数转换）
MIN_PRICE_USDC=0.01
